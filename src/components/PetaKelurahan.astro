  function buildLegend(): void {
    const container = document.getElementById('legend-items');
    if (!container) return;
    container.innerHTML = Object.entries(RW_META).map(([name, m]) => `
      <div class="peta-legend-item" data-rw="${name}" title="Klik untuk zoom ke ${name}">
        <span class="legend-dot" style="background:${m.fillBase};"></span>
        <span>${m.icon} ${name}</span>
      </div>`).join('');
  }

  /* ─────────────────────────────────────────────────────────
     INISIALISASI MAP
  ───────────────────────────────────────────────────────── */
  function initMap(surveyStats: Record<string, RWStats>): void {
    const loading    = document.getElementById('peta-loading');
    const statusText = document.getElementById('api-status-text');
    const mapEl      = document.getElementById('leaflet-map');
    if (!mapEl) return;

    currentMode = 'sanitasi';

    const map = (window as any).L.map('leaflet-map', {
      center: [-4.038, 103.17], zoom: 12,
      zoomControl: true, scrollWheelZoom: true,
    });
    (window as any).map = map;

    /* Default: Satellite tile layer */
    let activeTile = (window as any).L.tileLayer(TILE_LAYERS.satellite.url, {
      attribution: TILE_LAYERS.satellite.attr,
      maxZoom: 19, subdomains: TILE_LAYERS.satellite.sub,
    }).addTo(map);

    /* Reset side panel to kelurahan-wide statistics initially */
    updateSidePanel('ALL', currentMode);

    // Initialize source text dynamically
    const sourceValEl = document.getElementById('peta-sumber-data-val');
    if (sourceValEl) {
      sourceValEl.textContent = 'KKNT 103 Kelompok 25 (Survei Lapangan Desa Sehat)';
    }

    /* ── INGERALISASI LAYER GRUP POI (SARANA) ── */
    const poiGroups: Record<string, any> = {
      sekolah: (window as any).L.layerGroup().addTo(map),
      faskes: (window as any).L.layerGroup().addTo(map),
      kebun: (window as any).L.layerGroup().addTo(map),
      pemukiman: (window as any).L.layerGroup().addTo(map)
    };

    function createCustomPoiIcon(emoji: string, colorClass: string) {
      return (window as any).L.divIcon({
        html: `<div class="custom-poi-marker ${colorClass}"><span>${emoji}</span></div>`,
        className: 'custom-poi-container',
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -28]
      });
    }

    function createPoiPopup(poi: any, categoryName: string) {
      const imageHtml = poi.url_foto ? `
        <div style="margin-bottom:0.5rem;border-radius:0.35rem;overflow:hidden;height:90px;background:#f3f4f6;">
          <img src="${poi.url_foto}" style="width:100%;height:100%;object-fit:cover;" onerror="this.remove()" />
        </div>` : '';
      return `
        <div class="poi-popup">
          <div class="poi-popup-header category-${categoryName}">
            <span class="poi-popup-logo">${poi.logo}</span>
            <div>
              <div class="poi-popup-title">${poi.name}</div>
              <div class="poi-popup-subtitle">${poi.rw} · Gunung Dempo</div>
            </div>
          </div>
          <div class="poi-popup-body">
            ${imageHtml}
            <p class="poi-popup-desc">${poi.desc}</p>
            <div class="poi-popup-coords">📍 Lat: ${poi.coords[0].toFixed(5)}, Lng: ${poi.coords[1].toFixed(5)}</div>
          </div>
        </div>
      `;
    }

    const activePoiData = (poiStore.sekolah.length || poiStore.faskes.length || poiStore.kebun.length || poiStore.pemukiman.length)
      ? poiStore
      : POI_DATA;

    Object.entries(activePoiData).forEach(([category, list]) => {
      const group = poiGroups[category];
      const colorClass = `color-${category}`;
      list.forEach(poi => {
        const marker = (window as any).L.marker(poi.coords, {
          icon: createCustomPoiIcon(poi.logo, colorClass)
        }).bindPopup(createPoiPopup(poi, category), {
          className: 'rw-popup',
          maxWidth: 240,
          autoPan: true
        });
        group.addLayer(marker);
      });
    });

    const chkSekolah = document.getElementById('chk-poi-sekolah') as HTMLInputElement;
    const chkFaskes = document.getElementById('chk-poi-faskes') as HTMLInputElement;
    const chkKebun = document.getElementById('chk-poi-kebun') as HTMLInputElement;
    const chkPemukiman = document.getElementById('chk-poi-pemukiman') as HTMLInputElement;

    function handlePoiCheckbox(chk: HTMLInputElement | null, group: any) {
      if (!chk) return;
      if (chk.checked) {
        map.addLayer(group);
      } else {
        map.removeLayer(group);
      }
      chk.addEventListener('change', (e) => {
        if ((e.target as HTMLInputElement).checked) {
          map.addLayer(group);
        } else {
          map.removeLayer(group);
        }
      });
    }

    handlePoiCheckbox(chkSekolah, poiGroups.sekolah);
    handlePoiCheckbox(chkFaskes, poiGroups.faskes);
    handlePoiCheckbox(chkKebun, poiGroups.kebun);
    handlePoiCheckbox(chkPemukiman, poiGroups.pemukiman);

    let geojsonLayer: any = null;
    let selectedLayer: any = null;

    function getTooltipText(feature: any, mode: 'sanitasi' | 'medis' | 'toga' | 'demografi') {
      const rwName = feature?.properties?.name || feature?.properties?.Name || '';
      const rwNum  = rwName.replace('RW ', '').trim();
      const key    = `RW ${rwNum}`;
      const stats  = surveyStats[key];
      const nameDusun = RW_META[key]?.rwName || '';
      
      let info = '';
      if (mode === 'sanitasi') {
        info = stats ? `🚿 Sanitasi Layak: <strong>${stats.persen_sanitasi}% (${stats.jamban_layak} KK)</strong>` : '⏳ Belum ada data';
      } else if (mode === 'medis') {
        info = stats ? `🏥 Indeks Sehat: <strong>${stats.indeks_sehat}%</strong>` : '⏳ Belum ada data';
      } else if (mode === 'toga') {
        const tanaman = togaStore[key] ?? [];
        const totalPlants = tanaman.reduce((s, t) => s + t.jumlah, 0);
        info = `🌿 TOGA: <strong>${totalPlants} btg</strong> (${tanaman.length} jenis)`;
      } else if (mode === 'demografi') {
        const dp = jumlahPendudukStore[key];
        info = dp ? `👥 Penduduk: <strong>${dp.total} jiwa</strong> (${dp.kk} KK)` : '⏳ Belum ada data';
      }
      
      return `
        <div style="font-family: 'Inter', sans-serif; font-size: 0.72rem; padding: 0.25rem 0.5rem; line-height: 1.4;">
          <div style="font-weight: 800; color: #111827; margin-bottom: 2px;">${key}</div>
          <div style="font-size: 0.62rem; color: #6b7280; font-weight: 600; text-transform: uppercase; margin-bottom: 4px;">${nameDusun}</div>
          <div style="color: #059669; font-weight: 600;">${info}</div>
        </div>
      `;
    }

    /* Compute choropleth fill for a feature */
    function featureStyle(feature: any, mode: 'sanitasi' | 'medis' | 'toga' | 'demografi') {
      const rwName = feature?.properties?.name || feature?.properties?.Name || '';
      const rwNum  = rwName.replace('RW ', '').trim();
      const key    = `RW ${rwNum}`;
      const stats  = surveyStats[key];
      const meta   = RW_META[key] ?? { color: '#6b7280', fillBase: '#9ca3af' };

      let fill: string;
      if (mode === 'toga') {
        const keys = Object.keys(togaStore);
        const densities = keys.map(k => {
          const plants = (togaStore[k] ?? []).reduce((s, t) => s + t.jumlah, 0);
          const areaMatch = (RW_META[k]?.luasHa || '').match(/\d+/);
          const area = areaMatch ? parseInt(areaMatch[0]) : 1;
          return plants / area;
        });
        const maxDensity = Math.max(...densities, 0.1);
        const curPlants = (togaStore[key] ?? []).reduce((s, t) => s + t.jumlah, 0);
        const areaMatch = (meta.luasHa || '').match(/\d+/);
        const area = areaMatch ? parseInt(areaMatch[0]) : 1;
        const curDensity = curPlants / area;
        const pct = Math.round((curDensity / maxDensity) * 100);
        fill = curPlants > 0 ? choroplethColor(pct, 'toga') : '#d1d5db';
      } else if (mode === 'demografi') {
        const keys = Object.keys(jumlahPendudukStore);
        const densities = keys.map(k => {
          const pop = jumlahPendudukStore[k]?.total || 0;
          const areaMatch = (RW_META[k]?.luasHa || '').match(/\d+/);
          const area = areaMatch ? parseInt(areaMatch[0]) : 1;
          return pop / area;
        });
        const maxDensity = Math.max(...densities, 0.1);
        const pop = jumlahPendudukStore[key]?.total || (stats ? stats.total_jiwa : 0);
        const areaMatch = (meta.luasHa || '').match(/\d+/);
        const area = areaMatch ? parseInt(areaMatch[0]) : 1;
        const curDensity = pop / area;
        const pct = Math.round((curDensity / maxDensity) * 100);
        fill = pop > 0 ? choroplethColor(pct, 'demografi') : '#d1d5db';
      } else if (!stats) {
        fill = '#d1d5db';
      } else {
        const pct = mode === 'sanitasi' ? stats.persen_sanitasi : stats.indeks_sehat;
        fill = choroplethColor(pct, mode);
      }
      return { color: '#ffffff', weight: 1.5, opacity: 0.9, fillColor: fill, fillOpacity: 0.55 };
    }

    /* Reset side panel when map click outside polygon */
    map.on('click', (e: any) => {
      if (e.originalEvent.target.id === 'leaflet-map') {
        if (selectedLayer) {
          selectedLayer.setStyle({ fillOpacity: 0.55, weight: 1.5, color: '#ffffff' });
          selectedLayer = null;
        }
        updateSidePanel('ALL', currentMode);
      }
    });

    /* Load GeoJSON */
    fetch('/kelurahan-gunung-dempo.geojson')
      .then(r => r.json())
      .then((data) => {
        geojsonLayer = (window as any).L.geoJSON(data, {
          style: (f: any) => featureStyle(f, currentMode),
          onEachFeature: (feature: any, layer: any) => {
            const rwName = feature?.properties?.name || feature?.properties?.Name || '';
            const rwNum  = rwName.replace('RW ', '').trim();
            const key    = `RW ${rwNum}`;

            layer.bindPopup(() => currentMode === 'toga' ? buildTogaPopup(key) : buildPopup(key, surveyStats[key], currentMode), {
              className: 'rw-popup', maxWidth: 300, autoPan: true,
            });

            layer.bindTooltip(() => getTooltipText(feature, currentMode), {
              sticky: true,
              direction: 'auto',
              opacity: 0.95
            });

            layer.on('mouseover', () => {
              layer.setStyle({ fillOpacity: 0.75, weight: 2.5, color: '#10b981' });
              layer.bringToFront();
            });
            layer.on('mouseout', () => {
              if (layer !== selectedLayer) {
                layer.setStyle({ fillOpacity: 0.55, weight: 1.5, color: '#ffffff' });
              }
            });
            layer.on('click', () => {
              if (selectedLayer && selectedLayer !== layer) {
                selectedLayer.setStyle({ fillOpacity: 0.55, weight: 1.5, color: '#ffffff' });
              }
              selectedLayer = layer;
              layer.setStyle({ fillOpacity: 0.8, weight: 3, color: '#059669' });
              
              // Dynamic Side Panel Update
              updateSidePanel(key, currentMode);
            });
          },
        }).addTo(map);

        map.fitBounds(geojsonLayer.getBounds(), { padding: [30, 30] });
        if (loading) setTimeout(() => loading.classList.add('hidden'), 300);

        /* Legend click → zoom */
        document.querySelectorAll('.peta-legend-item[data-rw]').forEach(el => {
          el.addEventListener('click', () => {
            const rw = el.getAttribute('data-rw') ?? '';
            geojsonLayer.eachLayer((layer: any) => {
              const rwName = layer.feature?.properties?.name || layer.feature?.properties?.Name || '';
              const key = `RW ${rwName.replace('RW ', '').trim()}`;
              if (key === rw) {
                map.fitBounds(layer.getBounds(), { padding: [40, 40] });
                layer.openPopup();
                
                // Select layer and trigger panel updates
                if (selectedLayer && selectedLayer !== layer) {
                  selectedLayer.setStyle({ fillOpacity: 0.55, weight: 1.5, color: '#ffffff' });
                }
                selectedLayer = layer;
                layer.setStyle({ fillOpacity: 0.8, weight: 3, color: '#059669' });
                updateSidePanel(key, currentMode);
              }
            });
          });
        });

        /* Mode toggle (sanitasi / medis / toga / demografi) */
        document.querySelectorAll('.layer-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const mode = btn.getAttribute('data-mode') as 'sanitasi' | 'medis' | 'toga' | 'demografi';
            currentMode = mode;

            // Update choropleth
            geojsonLayer.eachLayer((layer: any) => {
              layer.setStyle(featureStyle(layer.feature, mode));
            });
            if (selectedLayer) selectedLayer.setStyle({ fillOpacity: 0.8, weight: 3, color: '#059669' });

            // Update source text dynamically
            const sourceValEl = document.getElementById('peta-sumber-data-val');
            if (sourceValEl) {
              if (mode === 'demografi') {
                sourceValEl.textContent = 'Pemerintah Kelurahan Gunung Dempo (Data Lurah)';
              } else if (mode === 'toga') {
                sourceValEl.textContent = 'KKNT 103 Kelompok 25 (Survei Lapangan TOGA)';
              } else {
                sourceValEl.textContent = 'KKNT 103 Kelompok 25 (Survei Lapangan Desa Sehat)';
              }
            }

            // Update choropleth legend title & scale
            const title = document.getElementById('choro-title');
            const bar   = document.getElementById('choro-scale');
            if (mode === 'toga') {
              if (title) title.textContent = '🌿 Kepadatan TOGA (Tanaman/Ha)';
              if (bar)   bar.innerHTML = '<div class="choro-bar" style="background:linear-gradient(90deg,#dcfce7,#86efac,#15803d);"></div>';
            } else if (mode === 'demografi') {
              if (title) title.textContent = '👥 Kepadatan Penduduk (Jiwa/Ha)';
              if (bar)   bar.innerHTML = '<div class="choro-bar" style="background:linear-gradient(90deg,#f3e8ff,#c084fc,#8b5cf6,#4c1d95);"></div>';
            } else if (mode === 'sanitasi') {
              if (title) title.textContent = '% Sanitasi Layak';
              if (bar)   bar.innerHTML = '<div class="choro-bar" style="background:linear-gradient(90deg,#ef4444,#fbbf24,#10b981);"></div>';
            } else {
              if (title) title.textContent = '🏥 Indeks Desa Sehat';
              if (bar)   bar.innerHTML = '<div class="choro-bar" style="background:linear-gradient(90deg,#ef4444,#fbbf24,#10b981);"></div>';
            }

            // Sync dynamic sidebar dashboard
            const activeKey = selectedLayer 
              ? `RW ${(selectedLayer.feature.properties.name || selectedLayer.feature.properties.Name || '').replace('RW ', '').trim()}`
              : 'ALL';
            updateSidePanel(activeKey, mode);

            // Active state style
            document.querySelectorAll('.layer-btn').forEach(b => {
              b.classList.remove('active');
              b.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
          });
        });

        /* Basemap toggle */
        document.querySelectorAll('.basemap-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-layer') as keyof typeof TILE_LAYERS;
            const cfg = TILE_LAYERS[key];
            if (!cfg) return;
            map.removeLayer(activeTile);
            activeTile = (window as any).L.tileLayer(cfg.url, {
              attribution: cfg.attr, maxZoom: 19, subdomains: cfg.sub,
            }).addTo(map);
            if (geojsonLayer) geojsonLayer.bringToFront();
            document.querySelectorAll('.basemap-btn').forEach(b => {
              b.classList.remove('active'); b.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true');
          });
        });

      })
      .catch(err => {
        console.error('GeoJSON error:', err);
        if (loading) loading.innerHTML = '<p style="color:#dc2626">⚠️ Gagal memuat peta.</p>';
      });
  }

  /* ─────────────────────────────────────────────────────────
     BOOT: Fetch API → Agregasi → Render
  ───────────────────────────────────────────────────────── */
  buildLegend();

  const statusText  = document.getElementById('api-status-text');
  const loadingText = document.getElementById('loading-text');

  function boot(): void {
    if (typeof (window as any).L === 'undefined') {
      setTimeout(boot, 80);
      return;
    }

    // Init lightbox controls once
    lbInitControls();

    function loadMapData(url: string, isFallback: boolean = false): void {
      fetch(url)
        .then(r => {
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return r.json();
        })
        .then((payload: any) => {
          let rawData: KKRecord[];
          let galeriRaw: GaleriItem[] = [];
          let togaRaw:   TogaRecord[] = [];
          let pendudukRaw: any[] = [];
          let usiaRaw:     any[] = [];
          let pendidikanRaw: any[] = [];
          let agamaRaw:      any[] = [];
          let pekerjaanRaw:  any[] = [];
          let tempatUmumRaw: any[] = [];

          if (Array.isArray(payload)) {
            rawData = payload;
          } else {
            rawData       = payload.DESA_SEHAT_SURVEI || payload.survei || [];
            galeriRaw     = payload.GALERI || payload.galeri || [];
            togaRaw       = payload.TOGA || payload.toga || [];
            pendudukRaw   = payload.JUMLAH_PENDUDUK || [];
            usiaRaw       = payload.USIA_PENDUDUK || [];
            pendidikanRaw = payload.PENDIDIKAN_PENDUDUK || [];
            agamaRaw      = payload.AGAMA_PENDUDUK || [];
            pekerjaanRaw  = payload.PEKERJAAN_PENDUDUK || payload.pekerjaan || [];
            tempatUmumRaw = payload.TEMPAT_UMUM || [];
          }

          // Populate galeriStore (keyed by "RW X", filtered by tipe)
          if (galeriRaw.length > 0) {
            // Reset to prevent duplicate items in multiple fetch attempts
            Object.keys(galeriStore).forEach(k => delete galeriStore[k]);
            galeriRaw.forEach(item => {
              const rwStr  = String(item.rw || (item as any).RW || '').trim();
              const key    = `RW ${rwStr.replace('RW ', '').trim()}`;
              
              const rawUrl  = item.url_foto || (item as any)['Tautan Foto (Google Drive)'] || '';
              const rawKet  = item.keterangan || (item as any)['Keterangan Foto'] || '';
              const rawKeg  = item.kegiatan || (item as any)['Nama Kegiatan'] || '';
              const rawTgl  = item.tanggal || (item as any)['Tanggal Kegiatan'] || '';
              const rawTipe = item.tipe || (item as any)['Kategori Kegiatan'] || 'DS';

              const cleaned: GaleriItem = {
                rw:       rwStr,
                tipe:     String(rawTipe).includes('Toga') || String(rawTipe).toUpperCase() === 'TOGA' ? 'TOGA' : 'DS',
                url_foto: sanitizeDriveUrl(String(rawUrl)),
                keterangan: String(rawKet),
                kegiatan: String(rawKeg),
                tanggal:  formatTanggal(String(rawTgl)),
              };
              if (!galeriStore[key]) galeriStore[key] = [];
              galeriStore[key].push(cleaned);
            });
          } else {
            galeriStore = { ...GALERI_PLACEHOLDER };
          }

          // Populate togaStore (keyed by "RW X")
          if (togaRaw.length > 0) {
            Object.keys(togaStore).forEach(k => delete togaStore[k]);
            togaRaw.forEach(t => {
              const rwStr = String(t.rw || (t as any).RW || '').trim();
              const key = `RW ${rwStr.replace('RW ', '').trim()}`;
              const cleaned: TogaRecord = {
                rw: rwStr,
                nama_tanaman: String(t.nama_tanaman || (t as any)['Nama Tanaman Obat'] || ''),
                jumlah: Number(t.jumlah || (t as any)['Jumlah Tanaman'] || 0)
              };
              if (!togaStore[key]) togaStore[key] = [];
              togaStore[key].push(cleaned);
            });
          }

          // Populate demografi stores
          if (pendudukRaw.length > 0) {
            Object.keys(jumlahPendudukStore).forEach(k => delete jumlahPendudukStore[k]);
            pendudukRaw.forEach((row: any) => {
              const rwStr = String(row.RW || '').trim();
              const key = `RW ${rwStr.replace('RW ', '').trim()}`;
              jumlahPendudukStore[key] = {
                laki: Number(row['Laki-Laki'] || row.laki || 0),
                perempuan: Number(row['Perempuan'] || row.perempuan || 0),
                total: Number(row['Jumlah'] || row.total || row.jumlah || 0),
                kk: Number(row['KK'] || row.kk || 0)
              };
            });
          }

          if (usiaRaw.length > 0) {
            Object.keys(usiaStore).forEach(k => delete usiaStore[k]);
            usiaRaw.forEach((row: any) => {
              const rwStr = String(row.RW || '').trim();
              const key = `RW ${rwStr.replace('RW ', '').trim()}`;
              usiaStore[key] = row;
            });
          }

          if (pendidikanRaw.length > 0) {
            Object.keys(pendidikanStore).forEach(k => delete pendidikanStore[k]);
            pendidikanRaw.forEach((row: any) => {
              const rwStr = String(row['RW / Nama Wilayah'] || row.RW || '').trim();
              const key = `RW ${rwStr.replace('RW ', '').trim()}`;
              pendidikanStore[key] = {
                sd: Number(row['SD Sederajat (J)'] || row['SD / Sederajat'] || row.sd || 0),
                sltp: Number(row['SLTP Sederajat (J)'] || row['SLTP / Sederajat'] || row.sltp || 0),
                slta: Number(row['SLTA Sederajat (J)'] || row['SLTA / Sederajat'] || row.slta || 0),
                diploma: Number(row['Akademi/Diploma (J)'] || row['Diploma (D1-D4)'] || row.diploma || 0),
                sarjana: Number(row['Sarjana (J)'] || row['Sarjana (S1-S3)'] || row.sarjana || 0)
              };
            });
          }

          if (agamaRaw.length > 0) {
            Object.keys(agamaStore).forEach(k => delete agamaStore[k]);
            agamaRaw.forEach((row: any) => {
              const rwStr = String(row['RW / Nama Wilayah'] || row.RW || '').trim();
              const key = `RW ${rwStr.replace('RW ', '').trim()}`;
              agamaStore[key] = {
                islam: Number(row['Islam'] || row.islam || 0),
                kristen: Number(row['Kristen'] || row['Kristen / Katolik'] || row.kristen || 0),
                lain: Number(row['Agama & Kepercayaan Lainnya'] || row['Lainnya'] || row.lain || 0)
              };
            });
          }

          if (pekerjaanRaw.length > 0) {
            Object.keys(pekerjaanStore).forEach(k => delete pekerjaanStore[k]);
            pekerjaanRaw.forEach((row: any) => {
              const rwStr = String(row.RW || row['RW / Nama Wilayah'] || '').trim();
              const key = `RW ${rwStr.replace('RW ', '').trim()}`;
              pekerjaanStore[key] = {
                swasta: Number(row['Swasta/Belum Bekerja'] || row.swasta || 0),
                pns: Number(row['PNS'] || row.pns || 0),
                tni_polri: Number(row['TNI/Polri'] || row.tni_polri || 0),
                wiraswasta: Number(row['Wiraswasta'] || row.wiraswasta || 0),
                pelajar: Number(row['Pelajar/Mahasiswa'] || row.pelajar || 0),
                paramedis: Number(row['Paramedis'] || row.paramedis || 0),
                petani: Number(row['Petani/Ternak'] || row.petani || 0),
                pensiunan: Number(row['Pensiunan Purna'] || row.pensiunan || 0),
                buruh: Number(row['Buruh'] || row.buruh || 0),
                nelayan: Number(row['Nelayan'] || row.nelayan || 0),
                pedagang: Number(row['Pedagang'] || row.pedagang || 0),
                peg: Number(row['PEG'] || row.peg || 0),
                dosen: Number(row['Dosen'] || row.dosen || 0)
              };
            });
          }

          // Populate POI store dynamically
          if (tempatUmumRaw.length > 0) {
            Object.keys(poiStore).forEach(k => delete poiStore[k]);
            poiStore.sekolah = []; poiStore.faskes = []; poiStore.kebun = []; poiStore.pemukiman = [];
            
            tempatUmumRaw.forEach((row: any) => {
              const kat = String(row['Kategori'] || row.kategori || '').toLowerCase();
              const coordsStr = String(row['Titik Koordinat (Lat, Lng)'] || row.coords || '').trim();
              if (!coordsStr || coordsStr === '-') return;
              const parts = coordsStr.split(',');
              if (parts.length < 2) return;
              const lat = parseFloat(parts[0].trim());
              const lng = parseFloat(parts[1].trim());
              if (isNaN(lat) || isNaN(lng)) return;
              
              const category = kat.includes('sekolah') || kat.includes('pendidikan') ? 'sekolah'
                             : kat.includes('faskes') || kat.includes('sehat') || kat.includes('posyandu') || kat.includes('puskesmas') ? 'faskes'
                             : kat.includes('kebun') || kat.includes('toga') || kat.includes('kopi') || kat.includes('teh') || kat.includes('tani') ? 'kebun'
                             : 'pemukiman';
              
              const rwVal = row['RW'] || row['Lokasi / RW'] || '';
              poiStore[category].push({
                name: row['Nama Tempat / Produk'] || row.name || 'Tempat Umum',
                coords: [lat, lng],
                desc: row['Deskripsi Singkat'] || row.desc || '',
                logo: row['Icon / Simbol'] || row.logo || (category === 'sekolah' ? '🏫' : category === 'faskes' ? '🏥' : category === 'kebun' ? '🍃' : '🏡'),
                rw: rwVal ? `RW ${String(rwVal).replace('RW ', '').trim()}` : '',
                url_foto: sanitizeDriveUrl(row['Tautan Foto (Google Drive)'] || row.url_foto || '')
              });
            });
          }

          const stats = agregasiData(rawData);
          surveyStats = stats;

          // Update status indicator
          if (statusText) {
            const rwCount = Object.keys(stats).length;
            const kkTotal = Object.values(stats).reduce((a, s) => a + s.total_kk, 0);
            statusText.innerHTML = isFallback 
              ? `🟢 Live · Local Mode` 
              : `🟢 Live · ${kkTotal} KK dari ${rwCount} RW`;
          }

          initMap(stats);
        })
        .catch(err => {
          console.warn(`Fetch gagal untuk ${url}:`, err);
          if (!isFallback) {
            if (statusText) statusText.innerHTML = '⏳ Menghubungkan ke Lokal...';
            // Silent fallback ke data local
            loadMapData('/data-kesehatan-fallback.json', true);
          } else {
            if (statusText) statusText.innerHTML = '🟡 Offline · Data Statis';
            if (loadingText) loadingText.textContent = 'Memuat peta (mode offline)…';
            surveyStats = {};
            initMap({});
          }
        });
    }

    loadMapData(API_URL);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  /* Scroll reveal */
  const revealEls = document.querySelectorAll('#peta .reveal');
  new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }).observe
    ? (() => {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('visible'); }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach(el => obs.observe(el));
      })()
    : revealEls.forEach(el => el.classList.add('visible'));

})();
</script>