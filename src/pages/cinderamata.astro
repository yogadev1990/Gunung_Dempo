</style>

<script>
  // Live Editable Inputs Binding
  const inpPenerima = document.getElementById('inp-penerima') as HTMLInputElement;
  const inpSubPenerima = document.getElementById('inp-sub-penerima') as HTMLInputElement;
  const inpPesan = document.getElementById('inp-pesan') as HTMLTextAreaElement;
  const inpTanggal = document.getElementById('inp-tanggal') as HTMLInputElement;
  const inpDpl = document.getElementById('inp-dpl') as HTMLInputElement;
  const inpKetua = document.getElementById('inp-ketua') as HTMLInputElement;

  const dispPenerima = document.getElementById('disp-penerima')!;
  const dispSubPenerima = document.getElementById('disp-sub-penerima')!;
  const dispPesan = document.getElementById('disp-pesan')!;
  const dispTanggal = document.getElementById('disp-tanggal')!;
  const dispDpl = document.getElementById('disp-dpl')!;
  const dispKetua = document.getElementById('disp-ketua')!;

  inpPenerima?.addEventListener('input', () => { dispPenerima.textContent = inpPenerima.value || '...'; });
  inpSubPenerima?.addEventListener('input', () => { dispSubPenerima.textContent = inpSubPenerima.value || '...'; });
  inpPesan?.addEventListener('input', () => { dispPesan.textContent = inpPesan.value || '...'; });
  inpTanggal?.addEventListener('input', () => { dispTanggal.textContent = inpTanggal.value || '...'; });
  inpDpl?.addEventListener('input', () => { dispDpl.textContent = inpDpl.value || '...'; });
  inpKetua?.addEventListener('input', () => { dispKetua.textContent = inpKetua.value || '...'; });

  // Toggle Edit Panel
  const btnTogglePanel = document.getElementById('btn-toggle-panel');
  const editPanel = document.getElementById('edit-panel');
  btnTogglePanel?.addEventListener('click', () => {
    if (editPanel) {
      editPanel.hidden = !editPanel.hidden;
      btnTogglePanel.textContent = editPanel.hidden ? '⚙️ Edit Teks' : '✖️ Tutup Edit';
    }
  });

  // Instant High-DPI PNG Exporter
  const btnPng = document.getElementById('btn-download-png');
  btnPng?.addEventListener('click', async () => {
    const card = document.getElementById('cinderamata-card');
    if (!card) return;
    const origText = btnPng.textContent;
    btnPng.textContent = '⏳ Mengolah...';
    try {
      // @ts-ignore
      if (typeof htmlToImage !== 'undefined') {
        // @ts-ignore
        const dataUrl = await htmlToImage.toPng(card, { pixelRatio: 3, cacheBust: true });
        const link = document.createElement('a');
        link.download = 'Cinderamata_Kelurahan_Gunung_Dempo.png';
        link.href = dataUrl;
        link.click();
      }
    } catch (e) {
      console.error(e);
      window.print();
    } finally {
      btnPng.textContent = origText;
    }
  });

  // Instant High-DPI PDF Exporter
  const btnPdf = document.getElementById('btn-download-pdf');
  btnPdf?.addEventListener('click', async () => {
    const card = document.getElementById('cinderamata-card');
    if (!card) return;
    const origText = btnPdf.textContent;
    btnPdf.textContent = '⏳ Mengolah...';
    try {
      // @ts-ignore
      if (typeof htmlToImage !== 'undefined' && window.jspdf) {
        // @ts-ignore
        const dataUrl = await htmlToImage.toPng(card, { pixelRatio: 3, cacheBust: true });
        // @ts-ignore
        const { jsPDF } = window.jspdf;
        const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        pdf.addImage(dataUrl, 'PNG', 0, 0, 297, 210);
        pdf.save('Cinderamata_Kelurahan_Gunung_Dempo.pdf');
      } else {
        window.print();
      }
    } catch (e) {
      console.error(e);
      window.print();
    } finally {
      btnPdf.textContent = origText;
    }
  });

  // Print Handler
  document.getElementById('btn-print')?.addEventListener('click', () => {
    window.print();
  });
</script>
